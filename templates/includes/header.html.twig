{{ attach_library('alert_scheduler_client/alerts') }}
<div id="emergency-banner">
    <div class="container" data-alerts-container></div>
</div>
{% if is_front %}
    <div id="header-overlay">
{% endif %}
<div id="navbar-top" class="shadow-sm">
    <div class="container d-flex justify-content-between align-items-center">
        <div class="d-flex branding">
            <a href="https://lib.unb.ca">
                {% include '@unb_lib_theme/includes/unb-lib-logo.html.twig' %}
            </a>
        </div>
        <ul class="nav d-flex d-md-none">
            <li class="nav-item flex-fill text-center">
                {% if is_library and is_front %}
                    <a id="btn-hours" class="btn" href="#todays-lib-hours-block">
                        <span class="visually-hidden">Hours</span><span class="fa-solid fa-clock"></span>
                    </a>
                {% else %}
                    <button id="btn-hours" class="btn" aria-controls="banner" aria-expanded="false" data-target="#banner" data-toggle="collapse" aria-label="Toggle Hours">
                        <span class="visually-hidden">Hours</span><span class="fa-solid fa-clock"></span>
                    </button>
                {% endif %}
            </li>
            <li class="nav-item flex-fill text-center">
                <a id="btn-askus" class="btn" href="https://lib.unb.ca/help/ask-us">
                    <span class="visually-hidden">AskUs</span><span class="fa-solid fa-comments"></span>
                </a>
            </li>
            <li class="nav-item flex-fill text-center">
                <button id="btn-menu" class="animated-menu-icon btn" type="button" data-toggle="collapse" data-target="#navbar" aria-expanded="false" aria-controls="navbar" aria-label="Toggle navigation">
                    <span></span>
                    <span></span>
                    <span></span>
                    <span class="visually-hidden">Toggle navigation menu</span>
                </button>
            </li>
        </ul>
        <nav aria-label="Header Utility Menu" class="d-none d-md-block text-right">
            <ul id="menu-secondary" class="list-inline mb-1">
                <li class="list-inline-item">
                    <a href="https://lib.unb.ca/search">Search this Site</a>
                </li>
                <li class="list-inline-item">
                    <a href="https://lib.unb.ca/about/find-us">Floor Plans</a>
                </li>
                <li class="list-inline-item">
                    <a href="https://unb.ca">UNB<span class="fa-solid fs-xs fa-up-right-from-square ml-1 ms-1" aria-hidden="true"></span></a>
                </li>
            </ul>
            <ul id="header-buttons" class="list-inline mb-0">
                <li class="list-inline-item">
                    <a class="btn btn-sm btn-light border-dark"><span class="fa-solid fa-user mr-1 me-1" aria-hidden="true"></span>My Account</a>
                </li>
                <li class="list-inline-item">
                    <a class="btn btn-sm btn-dark"><span class="fa-solid fa-house-circle-check mr-1 me-1" aria-hidden="true"></span>Book Study Space</a>
                </li>
                <li class="list-inline-item">
                    <a class="btn btn-sm btn-warning"><span class="fa-solid fa-comments mr-1 me-1" aria-hidden="true"></span>Ask Us</a>
                </li>
            </ul>
        </nav>
    </div>
</div>
<nav aria-label="Main Menu" id="navbar-main" class="navbar navbar-expand-lg px-0">
    <div class="container">
        <div id="navbar-main-content" class="d-flex align-items-stretch flex-column flex-lg-row w-100">
            {% include '@unb_lib_theme/includes/megamenu.html.twig' %}
        </div>
    </div>
</nav>
{% if is_front %}
    </div>
{% endif %}
{% if banner_image %}
    <div id="banner" {{ attributes.addClass(banner_classes) }}>
        <div id="banner-image" style="background-image: url({{ banner_image }})">
            {% include '@unb_lib_theme/includes/hours.html.twig' %}
        </div>
    </div>
{% endif %}
